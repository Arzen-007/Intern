# Server runtime
NODE_ENV=development
PORT=5000

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=replace_with_database_user
DB_PASSWORD=replace_with_database_password
DB_NAME=intern_portal

# Authentication: use a unique random value of at least 32 characters
JWT_SECRET=replace_with_a_random_32_plus_character_secret

# CORS: comma-separated exact browser origins
CLIENT_ORIGINS=http://localhost:5173

# Demo data is disabled by default. Enable only for a local throwaway database.
SEED_DEMO_DATA=false
DEMO_USER_PASSWORD=replace_with_a_12_plus_character_demo_password
DEMO_SUPERADMIN_EMAIL=superadmin@intern.local
DEMO_ADMIN_EMAIL=admin@intern.local
DEMO_INTERN_EMAIL=intern@intern.local
